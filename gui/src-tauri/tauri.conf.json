{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YZJ Bridge",
  "mainBinaryName": "YZJBridge",
  "version": "0.2.2",
  "identifier": "com.kuaidi100.yzjbridge",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "云之家机器人桥接",
        "width": 1080,
        "height": 720,
        "minWidth": 960,
        "minHeight": 640,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "JinRyu",
    "homepage": "https://github.com/JinRyu-online/yzj_bot_bridge",
    "shortDescription": "云之家多机器人桥接控制面板",
    "longDescription": "本地常驻桥接服务：接收云之家机器人消息，路由到 Cursor / Claude / OpenAI 等后端，并从控制面板管理通道与日志。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/yzj-bridge.exe",
      "binaries/config.default.yaml"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/installer-hooks.nsh",
        "languages": ["SimpChinese", "English"]
      }
    }
  }
}
